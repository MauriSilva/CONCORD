{
  "name": "concord-desktop",
  "version": "1.0.0",
  "description": "Cliente Desktop do Concord",
  "author": "Mauricio Ferraz",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mauricioferraz.concord",
    "productName": "Concord",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      { "from": "../public", "to": "public" },
      { "from": "get_pid.exe", "to": "get_pid.exe" },
      { "from": "enum_windows.exe", "to": "enum_windows.exe" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": { "loopback-capture": "^4.0.0" },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0"
  }
}